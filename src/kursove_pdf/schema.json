{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoursePdfRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "date",
    "created_by",
    "orders"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "\\S"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "\\S"
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 10000
    },
    "orders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client",
          "warehouse_order",
          "invoice",
          "address",
          "product_count"
        ],
        "properties": {
          "client": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "\\S"
          },
          "company_phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "warehouse_order": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "invoice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "recipient": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          },
          "recipient_phone": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80
          },
          "address": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000,
            "pattern": "\\S"
          },
          "product_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S",
            "description": "Optional WMS customer ID. Only adjacent orders with matching ID and exact client name are grouped; absent ID falls back to exact name."
          }
        }
      }
    }
  }
}
